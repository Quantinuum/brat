open import lib.kernel

type A = Bool
type B = Nat
type C = Bool

--!exec-hugr
M2 :: { Qubit, Qubit -o Bit, Bit }
M2 = { M, M }

id(A) -> A
id = a => a

id2(A, B) -> A, B
id2 = a, b => a, b

--!exec true --> true
thId :: (fn :: {A -> A})
thId = { x => id(x) }

f'(A) -> B
f' = ?f'

g'(B) -> C
g' = ?g'

fg(A) -> C
fg = ?fg

id'(f :: {A -> A}, A) -> A
id' = f, a => f(a)

id''(A) -> A
id''(x) = id((id)(x))

copyNat(Nat) -> Nat, Nat
copyNat(x) = x, x

--!exec 2, 3 --> 5
add(Nat, Nat) -> Nat
add(0, y) = y
add(1, y) = 1 + y
add(succ(x), y) = add(1, add(x, y))

--!exec 3 --> 6
double(Nat) -> Nat
double(x) = add(copyNat(x))

-- test :: {A -> A}
-- test = id;?help

compTest({ A -> B }, { B -> C}) -> { A -> C }
compTest(f, g) = { x => g(f(x)) }

--!exec-hugr
justMeasure :: { c :: Qubit, d :: Qubit -o c :: Bit, d :: Bit }
justMeasure = { c, d => M2(c, d) }

--!exec-hugr
idq :: { Qubit -o Qubit }
idq = { q => q }

--!exec-hugr 0.314
phasedBell :: { (th :: Float) -> { c :: Qubit, d :: Qubit -o c :: Bit, d :: Bit } }
phasedBell(th) = {
  H,|;
  Rz(th),|;
  M,M
}

--!exec-hugr
test_phasedBell :: { Qubit, Qubit -o Bit, Bit }
test_phasedBell = phasedBell(1.43)