-- Stuff available in tket for compiling circuits

ext "tket.quantum.X" X :: { Qubit -o Qubit }
ext "tket.quantum.Y" Y :: { Qubit -o Qubit }
ext "tket.quantum.Z" Z :: { Qubit -o Qubit }
ext "tket.quantum.H" H :: { Qubit -o Qubit }
ext "tket.quantum.S" S :: { Qubit -o Qubit }
ext "tket.quantum.T" T :: { Qubit -o Qubit }
ext "tket.quantum.CX" CX :: { Qubit, Qubit -o Qubit, Qubit }
ext "tket.quantum.CY" CY :: { Qubit, Qubit -o Qubit, Qubit }
ext "tket.quantum.CZ" CZ :: { Qubit, Qubit -o Qubit, Qubit }
ext "tket.quantum.CH" CH :: { Qubit, Qubit -o Qubit, Qubit }

ext "builtin.Rx" Rx(Float) -> { Qubit -o Qubit }
ext "builtin.Ry" Ry(Float) -> { Qubit -o Qubit }
ext "builtin.Rz" Rz(Float) -> { Qubit -o Qubit }
ext "builtin.CRx" CRx(Float) -> { Qubit, Qubit -o Qubit, Qubit }
ext "builtin.CRy" CRy(Float) -> { Qubit, Qubit -o Qubit, Qubit }
ext "builtin.CRz" CRz(Float) -> { Qubit, Qubit -o Qubit, Qubit }

ext "builtin.M" M :: { Qubit -o Bit }
ext "builtin.measure" measure :: { Qubit -o q::Money, b::Bit }
ext "builtin.fresh" fresh :: { Money -o Qubit }

uncons(n :: #) -> { Vec(Qubit, succ(n)) -o Qubit, Vec(Qubit, n) }
uncons(_) = { cons(q, qs) => q, qs }

recons(n :: #) -> { Qubit, Vec(Qubit, n) -o Vec(Qubit, succ(n)) }
recons(_) = { q, qs => cons(q, qs) }

swap(Qubit, Qubit) -o Qubit, Qubit
swap(a, b) = b, a
