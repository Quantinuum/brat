--!exec Nat, true, { => 7 }, { => 11 } --> 7
if(X :: *, Bool, { -> X }, { -> X }) -> X
if(_, true, then, _) = then()
if(_, false, _, else) = else()

--!exec true --> 4
test(Bool) -> Nat
test(b) = if(Nat, b, { => 4 }, { => 12 })

--This is an 'xfail' as the expected value is clearly/deliberately wrong
--!exec-xfail 11
f :: Nat
f = test(false)

--!exec 12
f' :: Nat
f' = f