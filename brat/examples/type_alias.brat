type A(x) = Nat
type B = Bool

head(List(A(B))) -> A(B)
head(nil) = ?help
head(cons(x, xs)) = ?cons

--!exec some(3) --> true
--!exec none --> false
isSome(Option(A(B))) -> Bool
isSome(some(x)) = true
isSome(x) = false

--!exec some(3) --> false
--!exec none --> true
isNone(Option(A(B))) -> Bool
isNone(none) = true
isNone(x) = false
