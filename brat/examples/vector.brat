swap(Nat, Nat) -> Nat, Nat
swap = a, b => b, a

type A = Nat

isNil :: { Vec(A, 0) -> Bool }
isNil(nil) = true -- obvs
-- ALAN this case is ruled out statically, so adding isNil2 instead
-- isNil(cons(x, xs)) = false

isNil2 :: { n :: #, Vec(A, n) -> Bool }
isNil2(_, nil) = true -- TODO both cases here fail
isNil2(_, cons(x, xs)) = false


head(List(A)) -> A
-- head(nil) = ?head
head(cons(x, xs)) = ?cnos

qmap(n :: #, { Qubit -o Qubit }) -> { Vec(Qubit, n) -o Vec(Qubit, n) }
qmap(doub(_), g) = { ls =,= rs => qmap(!, g)(ls) =,= qmap(!, g)(rs) }
qmap(succ(doub(_)), g) = { ls =, q ,= rs => qmap(!, g)(ls) =, g(q) ,= qmap(!, g)(rs) }

riffle_shuffle(n :: #) -> { Vec(Qubit, 2*n) -o Vec(Qubit, 2*n) }
riffle_shuffle(_) = { xs =,= ys => xs =%= ys }
