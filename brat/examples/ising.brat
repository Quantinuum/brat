open import lib.kernel (Rx, recons, uncons)

ext "" ZZ(Float) -> { Qubit, Qubit -o Qubit, Qubit }

nn_ising(sites :: #, Float, Float)
     -> { Vec(Qubit, sites) -o Vec(Qubit, sites) }
nn_ising(0, _, _) = { [] => [] }
nn_ising(1, x, y) = { [q] => [(Rx(x))(q)] }
nn_ising(succ(succ(_)), x, y) = { qs => qs |>
  uncons;
  Rx(x), uncons;
  ZZ(y), ..;
  |, (recons; nn_ising(!, x, y));
  recons
}
