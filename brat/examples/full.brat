f(n :: #, Vec(Int, full(n))) -> Vec(Int, full(n))
f(0, []) = []
f(succ(n), xs) = xs -- Need vector patterns to test more

g(n :: #, Vec(Nat, succ(full(n))), Vec(Nat, succ(full(n)))) -> Vec(Nat, succ(full(succ(n))))
g(0, [x], [y]) = [x, y]
g(_, _, _) = ?todo -- Do the rest once we have vector patterns

countfulls(n :: #) -> Nat
countfulls(0) = 0
countfulls(1) = 1 -- need to define as full(1) == 1
countfulls(full(n)) = countfulls(n) + 1
countfulls(succ(n)) = countfulls(n)

--!exec [1]
test_countfulls2 :: Nat
test_countfulls2 = countfulls(2)

--!exec [2]
test_countfulls3 :: Nat
test_countfulls3 = countfulls(3)

--!exec [3]
test_countfulls126 :: Nat
test_countfulls126 = countfulls(126)

